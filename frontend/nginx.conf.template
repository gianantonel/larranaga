server {
    listen 80;

    # Servir la app React (build estático)
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy /api/* → backend FastAPI (igual que vite proxy en dev)
    # Se elimina el prefijo /api antes de reenviar, igual que vite hace con rewrite
    # BACKEND_URL es una env var (ej: http://backend:8000/ o http://larranaga-backend:8000/)
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
